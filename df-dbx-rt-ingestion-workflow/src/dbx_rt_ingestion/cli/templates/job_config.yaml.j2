# GENERATED by `dfx job add` from {{ spec_source }}
# Do not edit by hand — update the functional spec and re-run:
#   dfx job add --spec {{ spec_source }} --force
name: {{ job.name }}
domain: {{ job.domain }}
platform: {{ job.platform }}
version: 1.0.0
description: {{ job.description | default("", true) }}

source:
  type: {{ source.type }}
  cluster: {{ source.cluster }}
{% if source.options %}
  options:
{{ source.options | to_yaml(4) }}
{% endif %}
  topics:
{% for t in topics %}
    - name: {{ t.name }}
      schema:
        subject: {{ t.schema_subject }}
        version: v1
      parser:
        type: {{ t.format }}
{% if t.parser_options %}
        options:
{{ t.parser_options | to_yaml(10) }}
{% endif %}
{% if t.mapping %}
      mapping_file: {{ mapping_file_for(t) }}
{% endif %}
{% if t.quality %}
      quality:
{{ t.quality | dump_models | to_yaml(8) }}
{% endif %}
{% if t.options %}
      options:
{{ t.options | to_yaml(8) }}
{% endif %}
{% endfor %}

sink:
  type: delta
  table: {{ sink.full_table }}
  mode: {{ sink.mode }}
{% if sink.merge_keys %}
  merge_keys:
{{ sink.merge_keys | to_yaml(4) }}
{% endif %}
  trigger:
{{ trigger | to_yaml(4) }}

schema_management:
  repository: file
  options:
    base_path: resources/schemas

checkpoint_root: /Volumes/{{ sink.catalog }}/{{ sink.schema_name }}/checkpoints/{{ job.name }}

reliability:
  dlq:
    enabled: true
    table: {{ sink.full_table }}_dlq
  retry:
    max_attempts: 3
    initial_backoff_seconds: 5
  graceful_shutdown_marker: /Volumes/{{ sink.catalog }}/{{ sink.schema_name }}/control/{{ job.name }}.stop

observability:
  audit_table: {{ sink.catalog }}.{{ sink.schema_name }}.dfx_audit
  publishers:
    - type: log

feature_flags: {}

tags:
{% if tags %}
{{ tags | to_yaml(2) }}
{% else %}
  domain: {{ job.domain }}
  platform: {{ job.platform }}
{% endif %}
