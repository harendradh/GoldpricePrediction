# GENERATED by `dfx job add` from {{ spec_source }} — regenerate with --force.
# Included automatically by the project-level databricks.yml (resources/**/*.job.yml).
resources:
  jobs:
    {{ job_snake }}:
      name: "dfx-${var.environment}-{{ job.name }}"
      tags:
        framework: df-dbx-rt-ingestion-workflow
        domain: {{ job.domain }}
        platform: {{ job.platform }}
      continuous:
        pause_status: UNPAUSED
      tasks:
        - task_key: ingest
          spark_python_task:
            python_file: ./{{ job.platform }}_databricks.py
            parameters:
              - "--env"
              - "${var.environment}"
              - "--config"
              - "${workspace.file_path}/conf/jobs/{{ job.domain }}/{{ job_snake }}.yaml"
              - "--conf-dir"
              - "${workspace.file_path}/conf"
          libraries:
            - whl: ../../dist/*.whl
          new_cluster:
            spark_version: ${var.spark_version}
            node_type_id: ${var.node_type_id}
            num_workers: 2
            data_security_mode: SINGLE_USER
            spark_conf:
              spark.databricks.delta.optimizeWrite.enabled: "true"
